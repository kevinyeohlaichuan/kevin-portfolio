{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "liveUrl": {
      "type": "string",
      "format": "uri"
    },
    "demo": {
      "type": "string",
      "enum": [
        "gamuda",
        "platform"
      ]
    },
    "order": {
      "default": 99,
      "type": "number"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "tagline",
    "summary",
    "eyebrow",
    "result",
    "scope"
  ]
}