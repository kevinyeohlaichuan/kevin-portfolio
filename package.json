{
  "name": "kevin-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "start": "wrangler dev",
    "check": "astro check",
    "lint": "eslint . --ignore-pattern dist",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs",
    "cf:typegen": "wrangler types",
    "deploy:check": "node scripts/validate-deploy.mjs && node scripts/validate-production-secret.mjs",
    "deploy:dry": "npm run deploy:check && npm run build && wrangler deploy --dry-run --secrets-file .env.production",
    "deploy:preview": "npm run deploy:check && npm run build && wrangler versions upload --preview-alias staging --secrets-file .env.production",
    "deploy:promote": "wrangler versions deploy",
    "deploy": "npm run deploy:check && npm run build && wrangler deploy --secrets-file .env.production"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@babylonjs/core": "9.21.1",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "gsap": "3.15.0",
    "phaser": "4.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "wrangler": "4.124.0"
  },
  "type": "module"
}
