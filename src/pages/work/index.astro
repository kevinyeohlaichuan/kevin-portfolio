---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

export const prerender = true;

const work = (await getCollection("work")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Professional work — Kevin Yeoh"
  description="Production archviz at GoProp: the showroom experience, the browser showcase and the platform that matches buyers to a home."
>
  <main id="main">
    <SiteHeader current="work" />

    <section class="page-head">
      <p class="kicker"><span></span> Professional work</p>
      <h1>Three ways a project<br />gets shown.</h1>
      <p class="page-intro">
        Production work at GoProp: the showroom experience buyers walk into, the
        browser showcase they open from a link, and the platform that matches them
        to a home. Same buildings, three very different delivery problems.
      </p>
    </section>

    <section class="section entry-list">
      {work.map((entry) => (
        <article class="entry-row" data-status={entry.data.status}>
          <p class="project-eyebrow">
            {entry.data.eyebrow}
            {entry.data.status !== "delivered" && (
              <span class="status-badge">{entry.data.status === "in-progress" ? "In build" : "Planned"}</span>
            )}
          </p>
          <h2><a href={`/work/${entry.id}`}>{entry.data.title}</a></h2>
          <p class="project-summary">{entry.data.summary}</p>
          <p class="project-result">{entry.data.result}</p>
          <div class="scope-list">
            {entry.data.scope.map((item) => <span>{item}</span>)}
          </div>
          <a class="text-link" href={`/work/${entry.id}`}>
            Project details <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </section>

    <SiteFooter />
  </main>
</Base>
