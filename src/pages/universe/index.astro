---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { EAUCosmos } from "../../components/EAUCosmos";

export const prerender = true;

const entries = (await getCollection("universe"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// One flat list until a kind has enough entries to earn its own route.
// The threshold is roughly eight; below that, filters are noise.
const kinds = [...new Set(entries.map((entry) => entry.data.kind))];
---

<Base
  title="Eternal Amaris Universe"
  description="The shared setting behind Spicy MSG Studio's games: human, demon, immortal, spirit and machine bloodlines, and one gift that never stops being given."
>
  <main id="main">
    <SiteHeader current="universe" />

    <section class="page-head universe-head">
      <div class="universe-cosmos" aria-hidden="true"><EAUCosmos variant="card" /></div>
      <p class="kicker"><span></span> Eternal Amaris Universe</p>
      <h1>Five bloodlines.<br />One endless gift.</h1>
      <p class="page-intro">
        Human, demon, immortal, spirit and machine &mdash; and every crossing between
        them, down to those carrying all five. <em>Eternal Amaris</em> is the gift that
        never stops being given, and nobody here agrees on what it costs to receive it.
        Entries land on this page as the games make them real, not before.
      </p>
    </section>

    <section class="section entry-list">
      <p class="universe-count">
        {entries.length} {entries.length === 1 ? "entry" : "entries"}
        {kinds.length > 0 && <> · {kinds.join(" · ")}</>}
      </p>

      {entries.map((entry) => (
        <article class="entry-row universe-row">
          <p class="project-eyebrow">{entry.data.kind}</p>
          <h2><a href={`/universe/${entry.id}`}>{entry.data.title}</a></h2>
          <p class="project-summary">{entry.data.summary}</p>
          <a class="text-link" href={`/universe/${entry.id}`}>Read <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </section>

    <SiteFooter />
  </main>
</Base>
